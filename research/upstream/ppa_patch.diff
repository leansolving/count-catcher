+theorem setF_data_of_ge {α : Type _} (A : Array α) {i : Nat} (hi : A.size ≤ i) (v d : α) :
+    (A.setF i v d).data = A.data ++ (List.replicate (i - A.size) d ++ [v]) := by
+  rw [Array.setF_eq_of_ge A hi]
+  simp [List.append_assoc]
+
+/-- Every read of `A.setF i v d`: the new value at `i`, the old value below `A.size`,
+the padding value `d` at new positions strictly between `A.size` and `i`, nothing beyond `i`. -/
+theorem getElem?_setF_eq {α : Type _} (A : Array α) (i j : Nat) (v d : α) :
+    (A.setF i v d)[j]? =
+      if i = j then some v else if j < A.size then A[j]? else if j < i then some d else none := by
+  by_cases hi : i < A.size
+  · rw [Array.setF_eq_set hi, Array.get?_set]
+    by_cases hij : i = j
+    · subst hij; simp
+    · by_cases hjs : j < A.size
+      · simp [hij, hjs]
+      · have hji : ¬ j < i := fun h => hjs (Nat.lt_trans h hi)
+        simp [hij, hjs, hji, Array.get?_len_le A j (Nat.le_of_not_lt hjs)]
+  · have hi' : A.size ≤ i := Nat.le_of_not_lt hi
+    rw [Array.getElem?_eq_data_get?, setF_data_of_ge A hi' v d]
+    by_cases hjs : j < A.size
+    · have hij : ¬ i = j := fun h => hi (h ▸ hjs)
+      rw [List.get?_append (l₁ := A.data) (n := j) hjs, ← Array.getElem?_eq_data_get?]
+      simp [hij, hjs]
+    · have hsj : A.size ≤ j := Nat.le_of_not_lt hjs
+      rw [List.get?_append_right (l₁ := A.data) (n := j) hsj]
+      simp only [Array.data_length]
+      by_cases hji : j < i
+      · have hij : ¬ i = j := fun h => Nat.lt_irrefl j (h ▸ hji)
+        have hlt : j - A.size < i - A.size := tsub_lt_tsub_right_of_le hsj hji
+        have hlt' : j - A.size < (List.replicate (i - A.size) d).length := by
+          rw [List.length_replicate]; exact hlt
+        rw [List.get?_append (l₁ := List.replicate (i - A.size) d) (n := j - A.size) hlt',
+          List.get?_eq_get (l := List.replicate (i - A.size) d) (n := j - A.size) hlt',
+          List.get_replicate]
+        simp [hij, hjs, hji]
+      · by_cases hij : i = j
+        · subst hij
+          have hle : (List.replicate (i - A.size) d).length ≤ i - A.size := by
+            rw [List.length_replicate]
+          rw [List.get?_append_right (l₁ := List.replicate (i - A.size) d) (n := i - A.size) hle]
+          simp
+        · have hij' : i < j := Nat.lt_of_le_of_ne (Nat.le_of_not_lt hji) hij
+          have hlt : i - A.size < j - A.size := tsub_lt_tsub_right_of_le hi' hij'
+          have hle : (List.replicate (i - A.size) d ++ [v]).length ≤ j - A.size := by
+            rw [List.length_append, List.length_replicate, List.length_singleton]; exact hlt
+          rw [List.get?_len_le (l := List.replicate (i - A.size) d ++ [v]) (n := j - A.size) hle]
+          simp [hij, hjs, hji]
+
+/-- The statement of the sorried `Array.getElem?_setF` holds. -/
+theorem getElem?_setF_self {α : Type _} (A : Array α) (i : Nat) (v default : α) :
+    (A.setF i v default)[i]? = some v := by
+  simp [getElem?_setF_eq]
+
+end CpogFix
