+// As validate_literal for a literal: assume -xvar, add the defining clauses of the node's
+// subgraph to the active clauses, and let reduce_run refute the reduced problem; the final
+// proof clause, lifted into the context, is xvar | -context.
+int Cnf_reasoner::validate_node(int xvar, std::vector<int> &defs) {
+    if (unit_literals.find(xvar) != unit_literals.end() || unit_literals.find(-xvar) != unit_literals.end())
+	return 0;
+    new_context();
+    push_assigned_literal(-xvar);
+    for (int cid : defs)
+	activate_clause(cid);
+    int ncid = reduce_run(xvar);
+    for (int cid : defs)
+	deactivate_clause(cid);
+    pop_context();
+    return ncid;
+}
