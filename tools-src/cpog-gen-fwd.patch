+bool Cnf_reduced::run_solver_trim(int lemma_limit, bool *hinted) {
+    *hinted = false;
+    // Same solver call as without -T, so calls with short proofs cost nothing extra
+    if (!run_solver())
+	return false;
+    if ((int) proof_clauses.size() < lemma_limit)
+	return true;
+    // Long proof: drat-trim trims it and supplies the hints, instead of rup_validate
+    char pname[100];
+    char lname[100];
+    char cmd[350];
+    const char *cnfname = file_names[0];
+    snprintf(pname, 100, "%s.drat", cnfname);
+    const char *dratname = archive_string(pname);
+    file_names.push_back(dratname);
+    snprintf(lname, 100, "%s.lrat", cnfname);
+    const char *lratname = archive_string(lname);
+    file_names.push_back(lratname);
+    double start = tod();
+    FILE *pfile = fopen(dratname, "w");
+    if (pfile == NULL) {
+	err(false, "Couldn't open temporary proof file %s\n", dratname);
+	return false;
+    }
+    for (Clause *np : proof_clauses) {
+	np->show(pfile);
+	delete np;
+    }
+    proof_clauses.clear();
+    fclose(pfile);
+    snprintf(cmd, 350, "drat-trim %s %s -L %s > /dev/null", cnfname, dratname, lratname);
+    int rc = system(cmd);
+    incr_timer(TIME_SAT, tod()-start);
+    if (rc != 0)
+	err(false, "Executing command '%s' yielded return code %d\n", cmd, rc);
+    FILE *lfile = fopen(lratname, "r");
+    if (!lfile) {
+	err(false, "Couldn't open generated LRAT file %s\n", lratname);
+	return false;
+    }
+    if (!load_hinted_proof(lfile)) {
+	err(false, "Failed to read generated LRAT file %s\n", lratname);
+	fclose(lfile);
+	return false;
+    }
+    fclose(lfile);
+    if (proof_clauses.size() == 0 || proof_clauses.back()->length() != 0) {
+	err(false, "Execution of command '%s' did not generate empty clause\n", cmd);
+	return false;
+    }
+    report(3, "Drat-trim.  %s %d problem clauses.  %d proof clauses\n", cnfname, clause_count(), proof_clauses.size());
+    *hinted = true;
+    incr_count(COUNT_SAT_TRIMMED);
+    return true;
+}
