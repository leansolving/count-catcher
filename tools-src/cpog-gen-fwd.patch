+
+void Cnf_reasoner::restore_clause(int cid, Clause *np) {
+    proof_clauses[cid - clause_count() - 1] = np;
+    gc_candidates.push_back(cid);
+}
+
+void Cnf_reasoner::forget_clause(int cid) {
+    if (free_dead)
+	proof_clauses[cid - clause_count() - 1] = NULL;
+}
+
+bool Cnf_reasoner::garbage_due() {
+    return proof_clauses.size() >= gc_next;
+}
+
+// Free the proof clauses that no later step can access.  get_clause reaches a proof clause
+// only while it is active, waits on the context clause stack to become active again,
+// justifies a unit literal, is in a saved active-clause set (protected_sets), or is an
+// argument of a lemma under proof (lemma_stack); every other proof clause is only cited
+// by its ID.  Call only where no clause pointer is held.
+void Cnf_reasoner::collect_garbage() {
+    int base = clause_count();
+    size_t n = proof_clauses.size();
+    std::vector<bool> live(n+1, false);
+    auto mark = [&](int cid) {
+	if (cid > base && (size_t) (cid - base) <= n)
+	    live[cid - base] = true;
+    };
+    for (int cid : *curr_active_clauses)
+	mark(cid);
+    for (int cid : *next_active_clauses)
+	mark(cid);
+    for (int cid : context_clause_stack)
+	mark(cid);
+    for (auto fid : justifying_ids)
+	mark(fid.second);
+    for (std::set<int> *sp : protected_sets)
+	for (int cid : *sp)
+	    mark(cid);
+    for (Lemma_instance *lp : lemma_stack) {
+	for (auto fid : lp->inverse_cid) {
+	    mark(fid.first);
+	    mark(fid.second);
+	}
+	for (int cid : lp->duplicate_cid)
+	    mark(cid);
+    }
+    std::vector<int> keep;
+    for (int cid : gc_candidates) {
+	Clause *np = proof_clauses[cid - base - 1];
+	if (np == NULL)
+	    continue;
+	if (live[cid - base])
+	    keep.push_back(cid);
+	else {
+	    delete np;
+	    proof_clauses[cid - base - 1] = NULL;
+	    incr_count(COUNT_FREED_CLAUSE);
+	}
+    }
+    gc_candidates.swap(keep);
+    gc_next = n + std::max((size_t) 1 << 16, gc_candidates.size());
+}
