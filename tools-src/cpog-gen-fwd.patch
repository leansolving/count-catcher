+
+void Pog::hybrid_setup() {
+    tree_size.resize(nodes.size());
+    visit_mark.assign(nodes.size(), 0);
+    visit_epoch = 0;
+    hybrid_state = 0;
+    // Nodes are declared after their children
+    for (int i = 0; i < nodes.size(); i++) {
+	Pog_node *np = nodes[i];
+	double t = 1;
+	for (int j = 0; j < np->get_degree(); j++) {
+	    int clit = (*np)[j];
+	    if (is_node(clit))
+		t += tree_size[IABS(clit) - max_input_var - 1];
+	}
+	tree_size[i] = t;
+    }
+}
+
+// Adaptive gate (-W K): the hybrid pays where the structural justification needs SAT calls
+// (queens, dominoes, MC2022 instances with solver calls) and only adds calls where BCP alone
+// justifies the POG (grids, sharing-rich circuits).  So justifications are structural until
+// at least K of them are done and the SAT calls so far reach one per 1000 justifications;
+// from then on the hybrid is used.  The root of a POG that is within the size limit as a
+// whole is justified by one call at once.  (The gate does not catch every loss: MC2022
+// track2_019 makes SAT calls but reuses its 2,365 lemmas 21,174 times, which separate SAT
+// calls cannot; there the hybrid is 6.5x slower.  Race it against the structural mode.)
+bool Pog::hybrid_allowed(int rvar) {
+    if (cnf->hybrid_warmup == 0 || rvar == IABS(root_literal))
+	return true;
+    if (hybrid_state == 0 && vcount >= cnf->hybrid_warmup
+	&& (long) get_count(COUNT_SAT_CALL) * 1000 >= vcount) {
+	hybrid_state = 1;
+	incr_count_by(COUNT_HYBRID_GATE_AT, vcount);
+	report(1, "Hybrid mode on after %d justifications with %d SAT calls\n", vcount,
+	       get_count(COUNT_SAT_CALL));
+    }
+    return hybrid_state > 0;
+}
